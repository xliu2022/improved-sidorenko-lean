@[expose] def ImprovedSidorenko.extremalNumber : {r k : ℕ} → ImprovedSidorenko.RGraph (Fin k) r → ℕ → ℕ :=
fun {r k} F n => Nat.findGreatest (fun m => ∃ H, (¬∃ f, F.IsEmbedding H f) ∧ H.edges.card = m) (n.choose r)
@[expose] def ImprovedSidorenko.turanDensity : {r k : ℕ} → ImprovedSidorenko.RGraph (Fin k) r → ℝ :=
fun {r k} F => ⨅ n, ImprovedSidorenko.extremalDensity F (n + r)
