@[expose] def ImprovedSidorenko.RGraph.IsEmbedding.{u, v} : {V : Type u} →
  {W : Type v} →
    [inst : DecidableEq V] →
      [inst_1 : DecidableEq W] →
        {r : ℕ} → ImprovedSidorenko.RGraph V r → ImprovedSidorenko.RGraph W r → (V → W) → Prop :=
fun {V} {W} [DecidableEq V] [DecidableEq W] {r} F H f =>
  Function.Injective f ∧ ∀ e ∈ F.edges, Finset.image f e ∈ H.edges
@[expose] def ImprovedSidorenko.MainEmbeddingStatement : Prop :=
∀ (r : ℕ),
  3 ≤ r →
    ∀ (k : ℕ) (F : ImprovedSidorenko.RGraph (Fin k) r),
      1 ≤ F.edges.card →
        ∀ (q : ℝ),
          0 < q →
            q < ImprovedSidorenko.paperGap r F.edges.card →
              ∃ N,
                ∀ (n : ℕ),
                  N ≤ n →
                    ∀ (H : ImprovedSidorenko.RGraph (Fin n) r),
                      ImprovedSidorenko.hostDeficit H ≤ q → ∃ f, F.IsEmbedding H f
@[expose] def ImprovedSidorenko.TuranUpperBound : {r k : ℕ} → ImprovedSidorenko.RGraph (Fin k) r → ℝ → Prop :=
fun {r k} F b =>
  ∀ (ε : ℝ),
    0 < ε →
      ∃ N,
        ∀ (n : ℕ),
          N ≤ n →
            ∀ (H : ImprovedSidorenko.RGraph (Fin n) r),
              (¬∃ f, F.IsEmbedding H f) → ↑r.factorial * ↑H.edges.card / ↑n ^ r ≤ b + ε
@[expose] def ImprovedSidorenko.MainDensityStatement : Prop :=
∀ (r : ℕ),
  3 ≤ r →
    ∀ (k : ℕ) (F : ImprovedSidorenko.RGraph (Fin k) r),
      1 ≤ F.edges.card → ImprovedSidorenko.TuranUpperBound F (1 - ImprovedSidorenko.paperGap r F.edges.card)
@[expose] def ImprovedSidorenko.BinomialTuranUpperBound : {r k : ℕ} → ImprovedSidorenko.RGraph (Fin k) r → ℝ → Prop :=
fun {r k} F b =>
  ∀ (ε : ℝ),
    0 < ε →
      ∃ N,
        ∀ (n : ℕ),
          N ≤ n →
            ∀ (H : ImprovedSidorenko.RGraph (Fin n) r),
              (¬∃ f, F.IsEmbedding H f) → ImprovedSidorenko.binomialDensity H ≤ b + ε
ImprovedSidorenko.main_embedding : ImprovedSidorenko.MainEmbeddingStatement
ImprovedSidorenko.main_density : ImprovedSidorenko.MainDensityStatement
ImprovedSidorenko.main_binomial_density (r : ℕ) :
  3 ≤ r →
    ∀ (k : ℕ) (F : ImprovedSidorenko.RGraph (Fin k) r),
      1 ≤ F.edges.card → ImprovedSidorenko.BinomialTuranUpperBound F (1 - ImprovedSidorenko.paperGap r F.edges.card)
ImprovedSidorenko.main_binomial_limit_bound {r k : ℕ} (hr : 3 ≤ r) (F : ImprovedSidorenko.RGraph (Fin k) r)
  (hm : 1 ≤ F.edges.card) (H : (n : ℕ) → ImprovedSidorenko.RGraph (Fin n) r)
  (hfree : ∀ (n : ℕ), ¬∃ f, F.IsEmbedding (H n) f) {π : ℝ}
  (hlimit : Filter.Tendsto (fun n => ImprovedSidorenko.binomialDensity (H n)) Filter.atTop (nhds π)) :
  π ≤ 1 - ImprovedSidorenko.paperGap r F.edges.card
